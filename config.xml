 <widget id="A1868473493378564096"  version="1.1.0">
    <name>HelloApp</name>
    <description>
        Yuanbao tests on APICloud.
    </description>
    <author email="developer@apicloud.com" href="http://www.apicloud.com">
        Developer
    </author>
    <content src="html/test_SMS_main_frame.html" />
	<!-- index.html 页面中openFrame看目标页面 -->
	<!-- html/test_SMS_monitor.html、html/test_SMS_main_frame.html 直接打开短信监听页 -->

    <access origin="*" />
    <preference name="pageBounce" value="false"/>
	<preference name="appBackground" value="rgba(0,0,0,0.0)"/>
	<preference name="windowBackground" value="rgba(0,0,0,0.0)"/>
	<preference name="frameBackgroundColor" value="rgba(0,0,0,0.0)"/>
	<preference name="hScrollBarEnabled" value="false"/>
	<preference name="vScrollBarEnabled" value="false"/>
	<preference name="autoLaunch" value="true"/>
	<preference name="fullScreen" value="true"/> <!-- 是否全屏显示 -->
	<preference name="statusBarAppearance" value="true"/> <!-- 是否显示状态栏 -->
	<preference name="autoUpdate" value="true" />
	<preference name="smartUpdate" value="false" />
	<preference name="debug" value="true"/>
	
	<permission name="readPhoneState" />
	<permission name="camera" />
	<permission name="record" />
	<permission name="location" />
	<permission name="fileSystem" />
	<permission name="internet" />
	<permission name="bootCompleted" />
	<permission name="hardware" />
	<!-- Android 8.0+ 安装未知来源应用的权限（用于 app 自升级场景） -->
	<permission name="requestInstallPackages" />
	<!-- 读写外部存储（Android 10 以下需要，scoped storage 也建议声明） -->
	<permission name="readExternalStorage" />
	<permission name="writeExternalStorage" />

    <meta-data name="OFFLINE_APP_KEY" value="ynznjbcb2qzfcxabyrs7w5hj3cpmy5owxyuxb5aw"/>
    <meta-data name="OFFLINE_APP_SECRET" value="3cab1b99c13f84a692f63c50d16197e8"/>

	<feature name="IFlyVoice">
		<!-- <param name="appId_iOS" value="5bff50df"/> -->
		 <param name="appId_Android" value="5b1236fa" /> <!--5d11f8d5 -->
	</feature>

	<!-- 短信监听模块配置 -->
	<feature name="smsListener"/>
	<permission name="readSMS" />
	<preference name="backgroundMode" value="audio"/>
	<permission name="wakeLock" />
	<permission name="foregroundService" />
	<permission name="notification" />

	<!-- 原生音频流播放器：用于后台/锁屏循环警报（防 WebView 30 秒掐断） -->
	<feature name="audioStreamer"/>

	<!-- 分享模块（"关于应用"页右上角分享按钮） -->
	<feature name="shareAction">
		<param name="iosSafeArea" value="false"/>
	</feature>
	<!-- 剪贴板模块（备用的"从剪贴板导入"功能） -->
	<feature name="clipBoard"/>
	<!-- 文件浏览器模块（"导入数据"时弹出系统文件管理器，可返回上级浏览任意目录选 JSON） -->
	<feature name="fileBrowser"/>
	<!-- 文件系统模块（fileBrowser 选完文件后用 fs.readFile 读取，权限最稳） -->
	<feature name="fs"/>

</widget>
